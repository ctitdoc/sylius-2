includes:
    - phpstan-baseline.neon

parameters:
    stubFiles:
        # The client's types where it leaves data untyped (see the stub's header).
        - phpstan/stubs/AlmaClientEligibility.stub
    level: max
    reportUnmatchedIgnoredErrors: false
    paths:
        - src
        - tests

    excludePaths:
        # Makes PHPStan crash
        - 'src/DependencyInjection/Configuration.php'

        # Test dependencies
        - 'tests/TestApplication/src/**.php'

    ignoreErrors:
        -
            identifier: missingType.iterableValue
