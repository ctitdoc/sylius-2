<?xml version="1.0" encoding="UTF-8"?>
<!-- Unit tests of the plugin. Bootstrap: the plugin's own autoloader when installed on its own,
     else the one of the shop that mounts it (SYLIUS_AUTOLOAD, default /srv/sylius/vendor/autoload.php). -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
