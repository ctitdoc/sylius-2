<?php

namespace Alma\Client\Domain\Entity;

/**
 * What the client leaves untyped: the schedule rows of an eligibility answer. Payment types its
 * rows as Installment; Eligibility returns them raw. This stub declares their shape as observed on
 * Alma's sandbox on 7 November 2026 (and as the API reference says): integers in cents and seconds,
 * a localized date string, a nullable delta. The rows carry no `state`, so the client's Installment
 * cannot wrap them. To contribute to alma-php-client; question to Alma's team in the workspace README.
 */
class Eligibility
{
    /**
     * @return list<array{due_date?: int, purchase_amount?: int, customer_fee?: int, customer_interest?: int, total_amount?: int, localized_due_date?: string, time_delta_from_start?: int|null}>
     */
    public function getPaymentPlan(): array
    {
    }
}
